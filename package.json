{
  "name": "agent-telegram-inbox",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web,fwd -c cyan,magenta,green \"npm run dev:api\" \"npm run dev:web\" \"npm run dev:forwarder\"",
    "dev:all": "npm run dev",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "dev:forwarder": "node scripts/run-forwarder.mjs",
    "setup:forwarder": "node scripts/setup-forwarder.mjs",
    "start": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tesseract.js": "^7.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.2.1",
    "vite": "^8.2.2"
  }
}
