[Unit]
Description=Telegram personal-account forwarder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=telegram
Group=telegram
WorkingDirectory=/opt/telegram-forwarder
ExecStart=/opt/telegram-forwarder/.venv/bin/python /opt/telegram-forwarder/main.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

# Hardening (optional, tighten as you like)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/telegram-forwarder

[Install]
WantedBy=multi-user.target
