# ============================================================================
#  Telegram personal-account forwarder — configuration
#  Copy this file to ".env" and fill in the values. NEVER commit ".env".
# ============================================================================

# --- Telegram API credentials -------------------------------------------------
# Get these from https://my.telegram.org  ->  "API development tools".
# Keep TELEGRAM_API_HASH private (do not paste it in chats / commits / issues).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Personal account phone (optional) --------------------------------------
# International format, e.g. +14155550123
# If left empty you will be prompted interactively on the first login.
TELEGRAM_PHONE=

# --- Telethon session file --------------------------------------------------
# A file "<SESSION_NAME>.session" is created next to the app.
# This file grants full access to your Telegram account. Protect it. See README.
SESSION_NAME=user_session

# --- Destination -----------------------------------------------------------
# The group/channel that messages are forwarded INTO.
# Your PERSONAL account must be a member of this group.
# (A bot admin in the group is NOT required for this tool.)
DESTINATION_GROUP_ID=-5224113996

# --- Source (which chat to forward FROM) ----------------------------------
# Discover the id with:  python main.py --list-dialogs
# or set DISCOVERY_MODE=true below and read the log output.
# Nothing is forwarded unless a source is configured here.
SOURCE_CHAT_ID=

# --- Optional whitelist of extra source chat ids -------------------------
# Comma-separated. Merged with SOURCE_CHAT_ID. Example: -1001111111111,222222222
SOURCE_WHITELIST=

# --- Forward behaviour --------------------------------------------------
#   forward = native Telegram forward (keeps the "Forwarded from" header)
#   copy    = re-send the content as a brand-new message (no header)
FORWARD_MODE=forward

# --- Discovery mode --------------------------------------------------------
# true  = log the chat id / sender / preview of every incoming message and
#         forward NOTHING. Use this to find SOURCE_CHAT_ID, then set back to false.
DISCOVERY_MODE=false

# --- Logging / resilience ----------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=forwarder.log
RECONNECT_MAX_DELAY=60

# --- OPTIONAL, UNUSED for reading your personal account ------------------
# Only relevant if you later add destination-side *bot* features.
# If this token was ever exposed publicly, revoke & regenerate it in @BotFather
# BEFORE putting it here.
TELEGRAM_BOT_TOKEN=
