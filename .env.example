PORT=6000
# Generate a long random string for production, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=agent_telegram_inbox

# From @BotFather. Only used as a one-time seed into the `bot_config` DB
# table on first boot — after that, the DB row is the real source of truth
# and this value is ignored. Change the token from the Telegram API admin
# page in the dashboard instead of editing this file.
TELEGRAM_BOT_TOKEN=
# Set to a public https base URL to switch the bot to webhook (push) mode.
# Telegram will POST updates to <url>/api/telegram/webhook
# Leave blank for local dev -> falls back to long polling automatically.
TELEGRAM_WEBHOOK_URL=
# Optional; defaults to JWT_SECRET. Sent as the secret_token header by Telegram.
TELEGRAM_WEBHOOK_SECRET=
