PORT=6000
# Generate a long random string for production, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=agent_telegram_inbox

# From @BotFather. Keep the real value only in .env (never commit it).
TELEGRAM_BOT_TOKEN=
# TELEGRAM_POLL_MS only matters in long-polling mode (no webhook url set).
TELEGRAM_POLL_MS=2000
# Set to a public https base URL to switch the bot to webhook (push) mode.
# Telegram will POST updates to <url>/api/telegram/webhook
# Leave blank for local dev -> falls back to long polling automatically.
TELEGRAM_WEBHOOK_URL=
# Optional; defaults to JWT_SECRET. Sent as the secret_token header by Telegram.
TELEGRAM_WEBHOOK_SECRET=
